# Plantilla de referencia. Netlify NO lee este archivo: la variable real se
# crea en Netlify > Site configuration > Environment variables.
#
# Nombre exacto (debe empezar con VITE_ para que Vite la incluya en el build):
#   VITE_APPS_SCRIPT_URL
# Valor: URL del Web App, completa, sin comillas y terminada en /exec
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyHQVNYdNlaEe4lI30b0lNFCrGg35sEFqoISaYFhMdmzeYottlAZKPQAA3NRneyUQ3y6w/exec
